/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding: 60rpx 48rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-x: hidden;
}

.hero {
  margin-top: 40rpx;
  text-align: center;
}
.ball { font-size: 96rpx; line-height: 1; }
.title {
  margin-top: 16rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--court-green);
  letter-spacing: 2rpx;
}
.subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--text-soft);
}

.card {
  width: 100%;
  margin-top: 40rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(20, 83, 74, 0.06);
}

.intro .intro-line {
  font-size: 28rpx;
  color: var(--text);
  line-height: 2;
}
.intro .intro-line::before {
  content: "· ";
  color: var(--accent);
  font-weight: 700;
}

.gender-box { text-align: center; }
.gender-label { font-size: 30rpx; font-weight: 600; }
.gender-switch {
  margin: 28rpx auto 8rpx;
  display: flex;
  width: 100%;
  background: #eef2f1;
  border-radius: 999rpx;
  padding: 8rpx;
}
.gender-opt {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .2s;
}
.gender-opt .gs-sym { font-size: 38rpx; margin-right: 10rpx; font-weight: 700; }
.gender-opt .gs-cap { font-size: 28rpx; }
.gender-opt.female { color: #ff5fa2; }
.gender-opt.female.active { background: #ff5fa2; color: #fff; font-weight: 600; }
.gender-opt.male { color: #2f74e0; }
.gender-opt.male.active { background: #2f74e0; color: #fff; font-weight: 600; }
.gender-tip { font-size: 22rpx; color: #9aa8a4; margin-top: 10rpx; }

.start-btn {
  margin-top: 56rpx;
  width: 100%;
  background: var(--accent);
  color: #3a2c05;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 24rpx 0;
  box-shadow: 0 10rpx 24rpx rgba(232, 184, 75, 0.4);
}
.start-btn::after { border: none; }

.foot {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: #9aa8a4;
}

/* 四大类颜色分类展示 */
.cat-legend { overflow: hidden; }
.cat-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 22rpx;
}
.cat-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}
.cat-item {
  border: 2rpx solid #eee;
  border-radius: 18rpx;
  padding: 20rpx 16rpx;
  display: flex;
  align-items: center;
  min-width: 0;
  box-sizing: border-box;
}
.cat-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.cat-name {
  margin-left: 14rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.cat-letter {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-soft);
  opacity: 0.7;
}

/* 快速出结果按钮 */
.quick-btn {
  margin-top: 24rpx;
  width: 100%;
  background: #fff;
  color: var(--court-green);
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 22rpx 0;
  border: 2rpx solid var(--court-green);
}
.quick-btn::after { border: none; }

/* 快速出结果弹窗 */
.quick-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 40rpx;
  box-sizing: border-box;
}
.quick-panel {
  width: 100%;
  max-width: 640rpx;
  max-height: 84vh;
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 30rpx 30rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.quick-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text);
  text-align: center;
}
.quick-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-soft);
  text-align: center;
}
.quick-scroll {
  margin-top: 24rpx;
  flex: 1;
  min-height: 0;
}
.qg {
  border-radius: 20rpx;
  padding: 20rpx 18rpx;
  margin-bottom: 18rpx;
  box-sizing: border-box;
}
.qg-head {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.qg-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}
.qg-name {
  margin-left: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.qg-types {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}
.qg-chip {
  border: 2rpx solid #ccc;
  border-radius: 14rpx;
  padding: 14rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
  box-sizing: border-box;
}
.qg-code {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}
.qg-nick {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.2;
  word-break: break-all;
}
.quick-close {
  margin-top: 20rpx;
  width: 100%;
  background: var(--court-green);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 18rpx 0;
}
.quick-close::after { border: none; }
