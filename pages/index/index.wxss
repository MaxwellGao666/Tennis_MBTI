/* pages/index/index.wxss */
.page {
  min-height: 100vh;
  padding: 60rpx 48rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero {
  margin-top: 40rpx;
  text-align: center;
}
.ball { font-size: 96rpx; line-height: 1; }
.title {
  margin-top: 16rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: var(--court-green);
  letter-spacing: 2rpx;
}
.subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--text-soft);
}

.card {
  width: 100%;
  margin-top: 40rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(20, 83, 74, 0.06);
}

.intro .intro-line {
  font-size: 28rpx;
  color: var(--text);
  line-height: 2;
}
.intro .intro-line::before {
  content: "· ";
  color: var(--accent);
  font-weight: 700;
}

.gender-box { text-align: center; }
.gender-label { font-size: 30rpx; font-weight: 600; }
.gender-switch {
  margin: 28rpx auto 8rpx;
  display: flex;
  width: 100%;
  background: #eef2f1;
  border-radius: 999rpx;
  padding: 8rpx;
}
.gender-opt {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  color: var(--text-soft);
  border-radius: 999rpx;
  transition: all .2s;
}
.gender-opt.active {
  background: var(--court-green);
  color: #fff;
  font-weight: 600;
}
.gender-tip { font-size: 22rpx; color: #9aa8a4; margin-top: 10rpx; }

.start-btn {
  margin-top: 56rpx;
  width: 100%;
  background: var(--accent);
  color: #3a2c05;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 24rpx 0;
  box-shadow: 0 10rpx 24rpx rgba(232, 184, 75, 0.4);
}
.start-btn::after { border: none; }

.foot {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: #9aa8a4;
}
