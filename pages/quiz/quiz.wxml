<!--pages/quiz/quiz.wxml-->
<view class="page">
  <view class="progress-head">
    <text class="progress-text">第 {{index + 1}} / {{total}} 题</text>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{((index + 1) / total) * 100}}%"></view>
    </view>
  </view>

  <view class="q-card">
    <view class="q-tag">{{list[index].dimension}} 维度</view>
    <view class="q-text">{{list[index].question}}</view>

    <view class="options">
      <view
        class="option {{selected === item.value ? 'selected' : ''}}"
        wx:for="{{list[index].options}}"
        wx:for-index="oi"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="selectOption">
        <text class="option-dot">{{oi === 0 ? 'A' : 'B'}}</text>
        <text class="option-text">{{item.text}}</text>
        <text class="option-check" wx:if="{{selected === item.value}}">✓</text>
      </view>
    </view>
  </view>

  <view class="nav-row">
    <button class="nav-btn ghost {{index === 0 ? 'disabled' : ''}}" bindtap="prev" disabled="{{index === 0}}">上一题</button>
    <button class="nav-btn primary" bindtap="next">{{index === total - 1 ? '查看结果' : '下一题'}}</button>
  </view>
  <view class="nav-hint">先选一个选项，再点「{{index === total - 1 ? '查看结果' : '下一题'}}」</view>
</view>
