/* pages/quiz/quiz.wxss */
.page {
  position: relative;
  min-height: 100vh;
  padding: 40rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* 铺满屏幕的卡通球场背景图（小程序不支持 CSS 本地 background-image，用 image 组件做底图） */
.bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}
/* 内容层浮在背景之上 */
.progress-head,
.q-card,
.nav-row,
.nav-hint { position: relative; z-index: 1; }

.progress-head {
  margin-bottom: 28rpx;
  padding: 16rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(20, 83, 74, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  color: #fff;
}
.progress-text { font-size: 26rpx; font-weight: 600; color: #fff; }
.progress-track {
  margin-top: 16rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #e8b84b, #f3cf7e);
  border-radius: 999rpx;
  transition: width .3s ease;
}

.q-card {
  width: 100%;
  /* 半透明毛玻璃，让卡通背景在卡片上下/四周透出 */
  background: rgba(255, 255, 255, 0.62);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 28rpx;
  padding: 40rpx 34rpx;
  box-shadow: 0 12rpx 40rpx rgba(20, 83, 74, 0.18);
  box-sizing: border-box;
  /* 不撑满剩余高度，整体更紧凑；上下居中让背景图在卡片上下露出 */
  flex: 0 0 auto;
  margin: auto 0;
}
.q-tag {
  display: inline-block;
  font-size: 24rpx;
  color: var(--court-green);
  background: #e3f0ed;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}
.q-text {
  margin-top: 22rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.55;
  color: var(--text);
  word-break: break-word;
}

.options { margin-top: 36rpx; }
.option {
  position: relative;
  display: flex;
  align-items: center;
  padding: 26rpx 24rpx;
  margin-bottom: 20rpx;
  background: #f6f9f8;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  transition: all .15s;
  box-sizing: border-box;
}
.option:last-child { margin-bottom: 0; }
.option.selected {
  background: #eaf5f2;
  border-color: var(--court-green);
  box-shadow: 0 6rpx 18rpx rgba(20, 83, 74, 0.12);
}
.option-dot {
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #fff;
  color: var(--court-green);
  font-weight: 700;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
}
.option.selected .option-dot { background: var(--court-green); color: #fff; }
.option-text {
  flex: 1;
  min-width: 0;
  font-size: 31rpx;
  line-height: 1.45;
  color: var(--text);
  word-break: break-word;
}
.option-check {
  flex-shrink: 0;
  margin-left: 14rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--court-green);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-row {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.nav-btn {
  flex: 1;
  margin: 0;
  font-size: 30rpx;
  padding: 20rpx 0;
  border-radius: 999rpx;
  text-align: center;
  box-sizing: border-box;
}
.nav-btn::after { border: none; }
.nav-btn.ghost {
  background: #fff;
  color: var(--court-green);
  border: 2rpx solid var(--court-green);
}
.nav-btn.ghost.disabled { opacity: .4; }
.nav-btn.primary {
  background: var(--accent);
  color: #3a2c05;
  font-weight: 700;
  border: none;
}
.nav-hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9aa8a4;
}
