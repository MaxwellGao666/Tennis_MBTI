/* pages/quiz/quiz.wxss */
.page {
  min-height: 100vh;
  padding: 48rpx 48rpx 60rpx;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
}

.progress-head { margin-bottom: 40rpx; }
.progress-text { font-size: 26rpx; color: var(--text-soft); }
.progress-track {
  margin-top: 16rpx;
  height: 14rpx;
  background: #e6ecea;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--court-green), var(--court-green-light));
  border-radius: 999rpx;
  transition: width .3s ease;
}

.q-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(20, 83, 74, 0.08);
  flex: 1;
}
.q-tag {
  display: inline-block;
  font-size: 24rpx;
  color: var(--court-green);
  background: #e3f0ed;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}
.q-text {
  margin-top: 28rpx;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.55;
  color: var(--text);
  word-break: break-word;
}

.options { margin-top: 56rpx; }
.option {
  position: relative;
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  margin-bottom: 28rpx;
  background: #f6f9f8;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  transition: all .15s;
}
.option.selected {
  background: #eaf5f2;
  border-color: var(--court-green);
  box-shadow: 0 6rpx 18rpx rgba(20, 83, 74, 0.12);
}
.option-dot {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #fff;
  color: var(--court-green);
  font-weight: 700;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.option.selected .option-dot { background: var(--court-green); color: #fff; }
.option-text {
  flex: 1;
  min-width: 0;
  font-size: 31rpx;
  line-height: 1.45;
  color: var(--text);
  word-break: break-word;
}
.option-check {
  flex-shrink: 0;
  margin-left: 16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--court-green);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-row {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.nav-btn {
  flex: 1;
  font-size: 30rpx;
  padding: 22rpx 0;
  border-radius: 999rpx;
  text-align: center;
}
.nav-btn::after { border: none; }
.nav-btn.ghost {
  background: #fff;
  color: var(--court-green);
  border: 2rpx solid var(--court-green);
}
.nav-btn.ghost.disabled { opacity: .4; }
.nav-btn.primary {
  background: var(--accent);
  color: #3a2c05;
  font-weight: 700;
  border: none;
}
.nav-hint {
  margin-top: 18rpx;
  text-align: center;
  font-size: 22rpx;
  color: #9aa8a4;
}
