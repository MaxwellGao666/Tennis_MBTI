<view class="page" style="--theme:{{themePrimary}}; background:{{themeBg}};">

  <!-- 大字标题 -->
  <view class="hero">
    <view class="rarity-badge" style="background:{{rarityColor}}">{{info.rarity}}</view>
    <view class="type-code">{{type}}</view>
    <view class="type-nick">{{info.name}} · {{info.nickname}}</view>
    <view class="role-tag" style="color:{{themePrimary}}; border-color:{{themePrimary}}">{{themeRoleName}}</view>
  </view>

  <!-- 性别切换（♀ 粉 / ♂ 蓝） -->
  <view class="gender-switch">
    <view class="gender-opt female {{gender === 'female' ? 'active' : ''}}"
          data-gender="female" bindtap="switchGender">
      <text class="gs-sym">♀</text><text class="gs-cap">女生球星</text>
    </view>
    <view class="gender-opt male {{gender === 'male' ? 'active' : ''}}"
          data-gender="male" bindtap="switchGender">
      <text class="gs-sym">♂</text><text class="gs-cap">男生球星</text>
    </view>
  </view>

  <!-- 可保存/分享的卡片预览（扑克牌竖版：上球星，下文案，右下二维码位） -->
  <view class="share-card" style="border-color:{{themePrimary}}">
    <!-- 上半：球星图 -->
    <view class="sc-photo-wrap">
      <image wx:if="{{starImageOk}}" class="sc-photo" src="{{star.image}}" mode="aspectFill" binderror="onStarImgError"></image>
      <view wx:else class="sc-photo fallback" style="background:{{themePrimary}}">{{starInitial}}</view>
      <view class="sc-photo-name">{{star.name}}</view>
    </view>
    <!-- 下半：信息 -->
    <view class="sc-info">
      <view class="sc-row">
        <view class="sc-type">{{type}}</view>
        <view class="sc-rarity" style="background:{{rarityColor}}">{{info.rarity}}</view>
      </view>
      <view class="sc-nick">{{info.name}} · {{info.nickname}}</view>
      <view class="sc-role" style="color:{{themePrimary}};border-color:{{themePrimary}}">{{themeRoleName}}</view>
      <view class="sc-summary">{{info.cardSummary}}</view>
      <view class="sc-bottom">
        <view class="sc-tip">网球 MBTI · 扫码测你的类型</view>
        <view class="sc-qr" style="border-color:{{themePrimary}}">
          <view class="sc-qr-dots" style="background:{{themePrimary}}"></view>
          <view class="sc-qr-dots" style="background:{{themePrimary}}"></view>
          <view class="sc-qr-dots" style="background:{{themePrimary}}"></view>
          <view class="sc-qr-dots" style="background:{{themePrimary}}"></view>
          <view class="sc-qr-dots" style="background:{{themePrimary}}"></view>
          <view class="sc-qr-dots" style="background:{{themePrimary}}"></view>
          <view class="sc-qr-dots" style="background:{{themePrimary}}"></view>
          <view class="sc-qr-dots" style="background:{{themePrimary}}"></view>
          <view class="sc-qr-dots" style="background:{{themePrimary}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 区块 A：你的 MBTI -->
  <view class="block">
    <view class="block-title"><text class="num">A</text>你的 MBTI 是什么样的</view>
    <view class="block-body">{{info.traits}}</view>
  </view>

  <!-- 区块 B：你的球风 -->
  <view class="block">
    <view class="block-title"><text class="num">B</text>结合网球 · 你的球风</view>
    <view class="block-body">{{info.tennisStyle}}</view>
  </view>

  <!-- 区块 C：本命球星（详细） -->
  <view class="block star-block">
    <view class="block-title"><text class="num">C</text>你的本命球星 · {{star.name}}</view>

    <view class="star-head">
      <image wx:if="{{starImageOk}}" class="star-photo" src="{{star.image}}" mode="aspectFill" binderror="onStarImgError"></image>
      <view wx:else class="star-photo fallback">{{starInitial}}</view>
      <view class="star-meta">
        <view class="star-name">{{star.name}}</view>
        <view class="star-sub">{{gender === 'female' ? '女子' : '男子'}}网球 · 你的本命球星</view>
      </view>
    </view>

    <view class="star-tag">打法</view>
    <view class="block-body">{{star.playStyle}}</view>
    <view class="star-tag accent">共鸣点 · 为什么你们是同类</view>
    <view class="block-body highlight">{{star.resonance}}</view>
  </view>

  <!-- 区块 D：球风建议 -->
  <view class="block">
    <view class="block-title"><text class="num">D</text>给你的一点球风建议</view>
    <view class="block-body">{{info.advice}}</view>
  </view>

  <!-- 操作区：2x2 网格（minmax(0,1fr) 防止右侧溢出） -->
  <view class="actions">
    <button class="act-btn primary" bindtap="saveCard">保存卡片到相册</button>
    <button class="act-btn share" open-type="share">分享给微信好友</button>
    <button class="act-btn ghost" bindtap="showReward">打赏作者</button>
    <button class="act-btn ghost" bindtap="retest">再测一次</button>
  </view>
  <view class="foot">结果由 16 题自测得出，仅供娱乐参考</view>

  <!-- 离屏卡片画布 -->
  <canvas type="2d" id="cardCanvas" class="card-canvas"></canvas>

  <!-- 打赏弹窗 -->
  <view wx:if="{{showReward}}" class="modal-mask" bindtap="hideReward">
    <view class="modal" catchtap="noop">
      <view class="modal-title">打赏作者</view>
      <view class="qr-box">
        <image wx:if="{{rewardQr}}" class="qr-img" src="{{rewardQr}}" mode="aspectFit"></image>
        <view wx:else class="qr-placeholder">微信收款码占位</view>
      </view>
      <view class="qr-tip">纯自愿 · 你的支持是我继续优化的动力</view>
      <button class="modal-close" bindtap="hideReward">关闭</button>
    </view>
  </view>
</view>
