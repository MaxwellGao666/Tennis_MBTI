/* pages/result/result.wxss */
.page {
  min-height: 100vh;
  padding: 0 40rpx 60rpx;
  background: var(--bg);
  overflow-x: hidden;
}

.hero {
  text-align: center;
  padding: 56rpx 0 36rpx;
}
.type-code {
  font-size: 100rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  color: var(--court-green);
  line-height: 1.1;
}
.type-name {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: var(--accent);
}

.block {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 26rpx rgba(20, 83, 74, 0.06);
}
.block-title {
  font-size: 33rpx;
  font-weight: 700;
  color: var(--text);
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: var(--court-green);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.block-body {
  font-size: 31rpx;
  line-height: 1.85;
  color: #36453f;
  word-break: break-word;
}

.star-block { border: 2rpx solid rgba(232, 184, 75, 0.5); }
.star-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}
.star-photo {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eef2f1;
  margin-right: 26rpx;
}
.star-photo.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, var(--court-green), var(--court-green-light));
}
.star-meta { flex: 1; min-width: 0; }
.star-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
}
.star-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-soft);
}
.star-tag {
  margin: 22rpx 0 10rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--court-green);
}
.star-tag.accent { color: #b8862a; }
.block-body.highlight {
  color: var(--text);
  background: #fbf6ea;
  border-radius: 16rpx;
  padding: 22rpx;
}

/* 性别切换：♀ 粉 / ♂ 蓝 */
.gender-switch {
  display: flex;
  background: #eef2f1;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 28rpx;
}
.gender-opt {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .2s;
}
.gender-opt .gs-sym { font-size: 38rpx; margin-right: 10rpx; font-weight: 700; }
.gender-opt .gs-cap { font-size: 28rpx; }
.gender-opt.female { color: #ff5fa2; }
.gender-opt.female.active { background: #ff5fa2; color: #fff; font-weight: 600; }
.gender-opt.male { color: #2f74e0; }
.gender-opt.male.active { background: #2f74e0; color: #fff; font-weight: 600; }

/* 操作区：2x2 网格 */
.actions {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.act-btn {
  width: 48.5%;
  margin-bottom: 22rpx;
  padding: 24rpx 0;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}
.act-btn::after { border: none; }
.act-btn.primary { background: var(--accent); color: #3a2c05; }
.act-btn.share { background: var(--court-green); color: #fff; }
.act-btn.ghost {
  background: #fff;
  color: var(--court-green);
  border: 2rpx solid var(--court-green);
}

.foot {
  text-align: center;
  font-size: 22rpx;
  color: #9aa8a4;
  margin: 16rpx 0 20rpx;
}

/* 离屏卡片画布 */
.card-canvas {
  position: fixed;
  left: 0;
  top: -9999px;
  width: 360px;
  height: 480px;
}

/* 打赏弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
}
.modal-title { font-size: 36rpx; font-weight: 700; color: var(--text); }
.qr-box { margin: 32rpx auto 12rpx; width: 320rpx; height: 320rpx; }
.qr-img { width: 100%; height: 100%; }
.qr-placeholder { margin: 32rpx auto 12rpx; }
.qr-box-inner {
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto;
  border-radius: 20rpx;
  background: #f3f6f5;
  border: 2rpx dashed #c7d2cf;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
}
.qr-tip { font-size: 24rpx; color: #9aa8a4; margin-top: 14rpx; }
.modal-sub { font-size: 24rpx; color: var(--text-soft); margin: 20rpx 0 28rpx; }
.modal-close {
  background: var(--court-green);
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
  padding: 18rpx 0;
}
.modal-close::after { border: none; }
