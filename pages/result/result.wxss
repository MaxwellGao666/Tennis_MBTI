/* pages/result/result.wxss */
.page {
  width: 100%;
  min-height: 100vh;
  padding: 0 32rpx 60rpx;
  /* 背景与主题色由内联 style 注入（--theme / background） */
  overflow-x: hidden;
  box-sizing: border-box;
}

/* ===== Hero 大字标题 ===== */
.hero {
  text-align: center;
  padding: 52rpx 0 30rpx;
  position: relative;
}
.rarity-badge {
  display: inline-block;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 18rpx;
}
.type-code {
  font-size: 108rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  color: var(--theme);
  line-height: 1.1;
}
.type-nick {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
}
.role-tag {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 26rpx;
  border: 2rpx solid var(--theme);
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
}

/* ===== 性别切换：♀ 粉 / ♂ 蓝 ===== */
.gender-switch {
  display: flex;
  width: 100%;
  background: #eef2f1;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 26rpx;
  box-sizing: border-box;
}
.gender-opt {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .2s;
}
.gender-opt .gs-sym { font-size: 38rpx; margin-right: 10rpx; font-weight: 700; }
.gender-opt .gs-cap { font-size: 28rpx; }
.gender-opt.female { color: #ff5fa2; }
.gender-opt.female.active { background: #ff5fa2; color: #fff; font-weight: 600; }
.gender-opt.male { color: #2f74e0; }
.gender-opt.male.active { background: #2f74e0; color: #fff; font-weight: 600; }

/* ===== 可保存/分享卡片区（扑克牌竖版） ===== */
.share-card {
  width: 100%;
  max-width: 560rpx;
  margin: 0 auto 30rpx;
  background: #fff;
  border: 4rpx solid var(--theme);
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
}
.sc-photo-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
  background: #eef2f1;
  overflow: hidden;
}
.sc-photo {
  width: 100%;
  height: 100%;
  display: block;
}
.sc-photo.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 140rpx;
  font-weight: 800;
  color: #fff;
}
.sc-photo-name {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 50rpx 24rpx 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(to top, rgba(0,0,0,0.55), transparent);
}
.sc-info {
  padding: 26rpx 28rpx 28rpx;
  box-sizing: border-box;
}
.sc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.sc-type {
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  color: var(--theme);
  line-height: 1;
}
.sc-rarity {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}
.sc-nick {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}
.sc-role {
  display: inline-block;
  padding: 4rpx 18rpx;
  border: 2rpx solid var(--theme);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}
.sc-summary {
  font-size: 27rpx;
  line-height: 1.75;
  color: #4a5568;
  word-break: break-word;
  margin-bottom: 22rpx;
}
.sc-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sc-tip {
  font-size: 22rpx;
  color: #a0aec0;
}
.sc-qr {
  width: 88rpx;
  height: 88rpx;
  border: 3rpx solid var(--theme);
  border-radius: 12rpx;
  display: flex;
  flex-wrap: wrap;
  align-content: center;
  justify-content: center;
  gap: 6rpx;
  padding: 6rpx;
  box-sizing: border-box;
}
.sc-qr-dots {
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
}

/* ===== 详细报告区块 ===== */
.block {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 26rpx rgba(20, 83, 74, 0.06);
  box-sizing: border-box;
}
.block-title {
  font-size: 33rpx;
  font-weight: 700;
  color: var(--text);
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: var(--theme);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.block-body {
  font-size: 31rpx;
  line-height: 1.85;
  color: #36453f;
  word-break: break-word;
}

.star-block { border: 2rpx solid var(--theme); }
.star-head {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 24rpx;
}
.star-photo {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eef2f1;
  margin-right: 26rpx;
}
.star-photo.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, var(--theme), var(--theme));
}
.star-meta { flex: 1; min-width: 0; overflow: hidden; }
.star-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
  word-break: break-word;
}
.star-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-soft);
}
.star-tag {
  margin: 22rpx 0 10rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--theme);
}
.star-tag.accent { color: #b8862a; }
.block-body.highlight {
  color: var(--text);
  background: #fbf6ea;
  border-radius: 16rpx;
  padding: 22rpx;
}

/* ===== 操作区：2x2 网格（minmax(0,1fr) 防右侧溢出） ===== */
.actions {
  width: 100%;
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx 30rpx;
  box-sizing: border-box;
}
.act-btn {
  width: 100%;
  margin: 0;
  padding: 22rpx 10rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
  min-width: 0;
  line-height: 1.3;
  white-space: normal;
  word-break: break-all;
}
.act-btn::after { border: none; }
.act-btn.primary { background: var(--theme); color: #fff; }
.act-btn.share { background: var(--theme); color: #fff; opacity: 0.92; }
.act-btn.ghost {
  background: #fff;
  color: var(--theme);
  border: 2rpx solid var(--theme);
}

.foot {
  width: 100%;
  text-align: center;
  font-size: 22rpx;
  color: #9aa8a4;
  margin: 16rpx 0 20rpx;
}

/* 离屏卡片画布：彻底移出视口，避免影响布局/滚动 */
.card-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

/* ===== 打赏弹窗 ===== */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 560rpx;
  max-width: 80%;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
  box-sizing: border-box;
}
.modal-title { font-size: 36rpx; font-weight: 700; color: var(--text); }
.qr-box { margin: 32rpx auto 12rpx; width: 320rpx; height: 320rpx; }
.qr-img { width: 100%; height: 100%; }
.qr-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0f0f0;
  border-radius: 16rpx;
  color: #999;
  font-size: 26rpx;
}
.qr-tip { font-size: 24rpx; color: var(--text-soft); margin-bottom: 28rpx; }
.modal-close {
  width: 100%;
  padding: 20rpx 0;
  border-radius: 999rpx;
  background: var(--theme);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}
.modal-close::after { border: none; }
