/* pages/result/result.wxss */
.page {
  width: 100%;
  min-height: 100vh;
  padding: 0 32rpx 60rpx;
  background: var(--bg);
  overflow-x: hidden;
  box-sizing: border-box;
}

.hero {
  text-align: center;
  padding: 56rpx 0 36rpx;
}
.type-code {
  font-size: 100rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  color: var(--court-green);
  line-height: 1.1;
}
.type-name {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: var(--accent);
}

.block {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 26rpx rgba(20, 83, 74, 0.06);
  box-sizing: border-box;
}
.block-title {
  font-size: 33rpx;
  font-weight: 700;
  color: var(--text);
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: var(--court-green);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.block-body {
  font-size: 31rpx;
  line-height: 1.85;
  color: #36453f;
  word-break: break-word;
}

.star-block { border: 2rpx solid rgba(232, 184, 75, 0.5); }
.star-head {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 24rpx;
}
.star-photo {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eef2f1;
  margin-right: 26rpx;
}
.star-photo.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, var(--court-green), var(--court-green-light));
}
.star-meta { flex: 1; min-width: 0; overflow: hidden; }
.star-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text);
  word-break: break-word;
}
.star-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-soft);
}
.star-tag {
  margin: 22rpx 0 10rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--court-green);
}
.star-tag.accent { color: #b8862a; }
.block-body.highlight {
  color: var(--text);
  background: #fbf6ea;
  border-radius: 16rpx;
  padding: 22rpx;
}

/* 性别切换：♀ 粉 / ♂ 蓝 */
.gender-switch {
  display: flex;
  width: 100%;
  background: #eef2f1;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 28rpx;
  box-sizing: border-box;
}
.gender-opt {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .2s;
}
.gender-opt .gs-sym { font-size: 38rpx; margin-right: 10rpx; font-weight: 700; }
.gender-opt .gs-cap { font-size: 28rpx; }
.gender-opt.female { color: #ff5fa2; }
.gender-opt.female.active { background: #ff5fa2; color: #fff; font-weight: 600; }
.gender-opt.male { color: #2f74e0; }
.gender-opt.male.active { background: #2f74e0; color: #fff; font-weight: 600; }

/* 操作区：2x2 网格 */
.actions {
  width: 100%;
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  box-sizing: border-box;
}
.act-btn {
  width: calc(50% - 12rpx);
  margin: 0 0 22rpx 0;
  padding: 22rpx 10rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
  min-width: 0;
  line-height: 1.3;
  white-space: normal;
}
.act-btn::after { border: none; }
.act-btn.primary { background: var(--accent); color: #3a2c05; }
.act-btn.share { background: var(--court-green); color: #fff; }
.act-btn.ghost {
  background: #fff;
  color: var(--court-green);
  border: 2rpx solid var(--court-green);
}

.foot {
  width: 100%;
  text-align: center;
  font-size: 22rpx;
  color: #9aa8a4;
  margin: 16rpx 0 20rpx;
}

/* 离屏卡片画布：彻底移出视口，避免影响布局/滚动 */
.card-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

/* 打赏弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 560rpx;
  max-width: 80%;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
  box-sizing: border-box;
}
.modal-title { font-size: 36rpx; font-weight: 700; color: var(--text); }
.qr-box { margin: 32rpx auto 12rpx; width: 320rpx; height: 320rpx; }
.qr-img { width: 100%; height: 100%; }
.qr-placeholder { margin: 32rpx auto 12rpx; }
.qr-box-inner {
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto;
  border-radius: 20rpx;
  background: #f3f6f5;
  border: 2rpx dashed #c7d2cf;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
}
.qr-tip { font-size: 24rpx; color: #9aa8a4; margin-top: 14rpx; }
.modal-sub { font-size: 24rpx; color: var(--text-soft); margin: 20rpx 0 28rpx; }
.modal-close {
  background: var(--court-green);
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
  padding: 18rpx 0;
}
.modal-close::after { border: none; }
