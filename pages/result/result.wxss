/* pages/result/result.wxss */
.page {
  min-height: 100vh;
  padding: 0 40rpx 60rpx;
  background: var(--bg);
}

.hero {
  text-align: center;
  padding: 56rpx 0 36rpx;
}
.type-code {
  font-size: 96rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  color: var(--court-green);
  line-height: 1.1;
}
.type-name {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--accent);
}

.block {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 26rpx rgba(20, 83, 74, 0.06);
}
.block-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: var(--court-green);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}
.block-body {
  font-size: 29rpx;
  line-height: 1.75;
  color: var(--text-soft);
}

.star-block { border: 2rpx solid rgba(232, 184, 75, 0.5); }
.star-tag {
  margin: 22rpx 0 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--court-green);
}
.star-tag.accent { color: #b8862a; }
.block-body.highlight {
  color: var(--text);
  background: #fbf6ea;
  border-radius: 16rpx;
  padding: 22rpx;
}

.gender-switch {
  display: flex;
  background: #eef2f1;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 28rpx;
}
.gender-opt {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  color: var(--text-soft);
  border-radius: 999rpx;
}
.gender-opt.active {
  background: var(--court-green);
  color: #fff;
  font-weight: 600;
}

.actions { margin-top: 8rpx; }
.act-btn {
  width: 100%;
  margin-bottom: 22rpx;
  padding: 24rpx 0;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
}
.act-btn::after { border: none; }
.act-btn.primary { background: var(--accent); color: #3a2c05; }
.act-btn.share { background: var(--court-green); color: #fff; }
.act-btn.ghost {
  background: #fff;
  color: var(--court-green);
  border: 2rpx solid var(--court-green);
}

.foot {
  text-align: center;
  font-size: 22rpx;
  color: #9aa8a4;
  margin: 16rpx 0 20rpx;
}

/* 离屏卡片画布 */
.card-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 300px;
  height: 400px;
}

/* 打赏弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  text-align: center;
}
.modal-title { font-size: 36rpx; font-weight: 700; color: var(--text); }
.qr-box { margin: 32rpx auto 12rpx; width: 320rpx; height: 320rpx; }
.qr-img { width: 100%; height: 100%; }
.qr-placeholder { margin: 32rpx auto 12rpx; }
.qr-box-inner {
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto;
  border-radius: 20rpx;
  background: #f3f6f5;
  border: 2rpx dashed #c7d2cf;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
}
.qr-tip { font-size: 24rpx; color: #9aa8a4; margin-top: 14rpx; }
.modal-sub { font-size: 24rpx; color: var(--text-soft); margin: 20rpx 0 28rpx; }
.modal-close {
  background: var(--court-green);
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
  padding: 18rpx 0;
}
.modal-close::after { border: none; }
